{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ras",
  "version": "0.1.0",
  "identifier": "com.jarvis.station",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/dev.mjs",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ras",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/jarvis-backend/": "backend/"
    },
    "category": "Finance",
    "shortDescription": "Ras \u2014 local trading intelligence station",
    "copyright": "",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
